# Strategy E V7.2 — safe example. Do not put production secrets in the build ZIP.
# Place the real file once at ~/Desktop/algo/kite_credentials/.env
# or set STRATEGY_E_SECRETS_DIR to another persistent directory.
STRATEGY_E_SECRETS_DIR=~/Desktop/algo/kite_credentials
STRATEGY_E_DATA_DIR=~/Desktop/algo/strategy_e_shared_data

MODE=PAPER
PORT=8081
BIND_HOST=127.0.0.1
TOTAL_CAPITAL=70000
TRADE_CAPITAL_PER_POSITION=35000
MIS_LEVERAGE=5
MAX_OPEN_POSITIONS=2
MAX_ENTRIES_PER_DAY=2
PARTIAL_R_FRACTION=0.50
FINAL_R_MULTIPLE=3.0
POST_PARTIAL_TIME_STOP_MINUTES=90
POST_PARTIAL_STAGNATION_PCT=0.20
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATE_AFTER_PARTIAL=true
TRAILING_LOCK_R=0.50
TRAILING_DISTANCE_R=1.00
PORTFOLIO_PROFIT_TARGET_ENABLED=true
PORTFOLIO_PROFIT_TARGET_INR=4500
PORTFOLIO_PROFIT_TARGET_MIN_POSITIONS=2
PORTFOLIO_PROFIT_TRAILING_ENABLED=true
PORTFOLIO_PROFIT_TRAILING_DISTANCE_INR=1000
DAILY_LOSS_LIMIT_ENABLED=true
DAILY_LOSS_LIMIT_INR=7000
DAILY_PROFIT_LOCK_ENABLED=true
DAILY_PROFIT_LOCK_INR=6000
MAX_CONSECUTIVE_LOSSES=2
MAX_ENTRY_RISK_PCT=2.0
RISK_BASED_SIZING_ENABLED=false
RISK_PER_TRADE_INR=1750
BREAK_EVEN_ENABLED=true
BREAK_EVEN_ACTIVATE_R=0.80
BREAK_EVEN_LOCK_R=0.00
FEATURE_GATE_MODE=SHADOW
FEATURE_SCORE_THRESHOLD=65
FEATURE_TRADE2_SCORE_THRESHOLD=75
FEATURE_MIN_BARS=30
FEATURE_MIN_ADX=18
FEATURE_MIN_RELATIVE_VOLUME=1.0
FEATURE_MIN_ATR_PCT=0.20
FEATURE_MAX_ATR_PCT=4.0
MARKET_REGIME_FILTER=true
MARKET_REGIME_SYMBOL=NIFTY 50
UNIVERSE_SYNC_ENABLED=true
OHLC_INITIAL_HISTORY_DAYS=90

TRADING_START=09:15
TRADING_END=15:00
FIRST_SIGNAL_CUTOFF=09:35
MAX_SIGNAL_CANDLE_PCT=8.0
ENTRY_ORDER_TYPE=MARKET
MARKET_PROTECTION=-1
PRODUCT=MIS
EXCHANGE=NSE
VALIDITY=DAY
ORDER_TIMEOUT_SECONDS=8
RECONCILE_INTERVAL_SECONDS=5
LTP_STALE_SECONDS=5
TRADING_ENABLED=false
ALLOW_LIVE_ORDERS=false
KILL_SWITCH=false
STARTUP_RECONCILE_REQUIRED=true
FLATTEN_ON_FATAL_ERROR=false
CHARTINK_WEBHOOK_TOKEN=REPLACE_WITH_LONG_RANDOM_WEBHOOK_TOKEN
KITE_API_KEY=
KITE_API_SECRET=
# Token is stored separately in the shared secret directory.
KITE_ACCESS_TOKEN_FILE=${HOME}/Desktop/algo/kite_credentials/.kite_access_token
KITE_REDIRECT_URL=
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_ADMIN_TOKEN
